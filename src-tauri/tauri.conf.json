{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "copicol",
  "version": "0.3.1",
  "identifier": "com.copicol.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "copicol",
        "width": 640,
        "height": 500,
        "minWidth": 480,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2MENGNDJFODFENTM1NzcKUldSM05kV0JMdlFNaG9UTU1yK0g2bTJmRG1pczBIVi9yWXNhdDVaVW5abVhETEp2VGcxcHhQUjcK",
      "endpoints": [
        "https://github.com/clementtoledano/copicol/releases/latest/download/latest.json"
      ]
    }
  }
}
